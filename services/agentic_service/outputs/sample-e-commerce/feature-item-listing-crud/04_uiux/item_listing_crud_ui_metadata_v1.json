{
  "pages": [
    {
      "page_id": "item-listing",
      "name": "Item Listing",
      "route": "/items",
      "actors": [
        "Admin/Manager"
      ],
      "covers_requirements": [
        "FR-001",
        "FR-006",
        "FR-007",
        "FR-008",
        "FR-009",
        "FR-010",
        "US-004",
        "US-005",
        "US-006",
        "US-008",
        "US-009",
        "AC-001",
        "AC-003",
        "AC-005",
        "AC-007",
        "AC-008"
      ],
      "layout_regions": [
        "header",
        "main",
        "footer"
      ],
      "components": [
        {
          "name": "SearchFilterBar",
          "reused_from_design_system": true,
          "covers_ui_expectations": [
            "Live search input with debouncing, plus filter dropdowns for category and price range"
          ],
          "content_elements": [
            "search term",
            "selected category",
            "price range min",
            "price range max"
          ]
        },
        {
          "name": "ItemTable",
          "reused_from_design_system": true,
          "covers_ui_expectations": [
            "A main page showing all items in a list/table/grid layout"
          ],
          "content_elements": [
            "item name",
            "item price",
            "stock quantity",
            "category"
          ]
        },
        {
          "name": "Pagination",
          "reused_from_design_system": true,
          "covers_ui_expectations": [
            "Pagination controls at the bottom of the list (previous/next, jump to page)"
          ],
          "content_elements": [
            "page number",
            "total pages"
          ]
        }
      ],
      "states": [
        "idle",
        "loading",
        "error",
        "success"
      ],
      "new_design_tokens": []
    },
